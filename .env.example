# Telegram credentials for brief submissions.
#
# These are read by the serverless function (netlify/functions/brief.mjs) and
# must be set in Netlify → Site settings → Environment variables.
#
# DO NOT prefix them with VITE_. Vite inlines every VITE_* variable into the
# client bundle at build time, which is exactly how the bot token used to end
# up published in a public JS file.

# Bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat id where briefs are delivered — get it from @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Google Analytics 4 ---------------------------------------------------
#
# Nothing to set here for production. The measurement id of the live property
# lives in src/lib/analytics.ts — it is public by design (it travels in every
# request GA receives), and Vite inlines env values at build time anyway, so an
# env var would neither hide it nor let you change it without rebuilding.
#
# Optional overrides for local work:
#
# Point a fork or a staging deploy at a different GA4 property:
# VITE_GA_ID=G-XXXXXXXXXX
#
# Measure localhost too — off by default so dev traffic stays out of the
# reports. Turn it on only while verifying the tracking itself.
# VITE_GA_DEBUG=true
